# Feedthing's site in Caddy on the box, uploaded by bin/deploy.
#
# Tailnet only: `import tailnet` drops anything not from a tailnet address
# (infra repo, docs/operations.md, "Tailnet-only apps"). HTTPS matters:
# browsers only allow service workers, and so push notifications, on it.
feedthing.ts.oceantume.dev {
	import tailnet
	encode zstd gzip
	import app-feedthing
}
