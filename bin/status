#!/usr/bin/env bash
# The app's two slots on the box: which is live (*), their releases (commits),
# and whether they're running and healthy.
#
#   bin/status [ssh host]     default: core@box
# Remote commands carry this side's values on purpose.
# shellcheck disable=SC2029
set -euo pipefail
cd "$(dirname "$0")/.."
HOST=${1:-core@box}
APP=$(sed -n 's/^IMAGE=//p' deploy/app.conf)

ssh "$HOST" /opt/bin/app-status "$APP"
